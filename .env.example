# =============================================
# .env.example — Hackathon #26 Changement Climatique
# Copier ce fichier en .env et remplir les valeurs
# =============================================

# Territoire d'étude (france | region | commune)
TERRITORY_LEVEL=france
TERRITORY_NAME=France
REGION_CODE=

# Clés API (optionnelles)
METEO_FRANCE_API_KEY=
COPERNICUS_KEY=        # Pour ERA5

# MLflow
MLFLOW_TRACKING_URI=./mlflow_runs
MLFLOW_EXPERIMENT_NAME=hackathon26_climat

# Configuration modèles
ENABLE_LSTM=true       # false si TensorFlow non disponible
ENABLE_PROPHET=true
TEST_SIZE=0.2
RANDOM_STATE=42

# Dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_THEME=dark
